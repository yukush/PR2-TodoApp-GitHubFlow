#!/usr/bin/env sh
# Offline-friendly bootstrap launcher for the pinned Gradle distribution.
# If a standard Gradle Wrapper JAR is added later, this script can be replaced
# with the canonical script generated by: gradle wrapper --gradle-version 8.14.6
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
PROPERTIES="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"
DISTRIBUTION_URL=$(sed -n 's/^distributionUrl=//p' "$PROPERTIES" | sed 's/\\:/:/g')
EXPECTED_SHA=$(sed -n 's/^distributionSha256Sum=//p' "$PROPERTIES")
ZIP_NAME=${DISTRIBUTION_URL##*/}
DIST_NAME=${ZIP_NAME%-bin.zip}
GRADLE_VERSION=${DIST_NAME#gradle-}
GRADLE_USER_HOME=${GRADLE_USER_HOME:-"$HOME/.gradle"}
DIST_ROOT="$GRADLE_USER_HOME/wrapper/dists/${DIST_NAME}-bin/bootstrap"
GRADLE_HOME="$DIST_ROOT/$DIST_NAME"
GRADLE_BIN="$GRADLE_HOME/bin/gradle"

if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$DIST_ROOT"
  ZIP_PATH="$DIST_ROOT/$ZIP_NAME"
  echo "Downloading Gradle $GRADLE_VERSION..."
  if command -v curl >/dev/null 2>&1; then
    curl --fail --location --retry 3 --output "$ZIP_PATH" "$DISTRIBUTION_URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$ZIP_PATH" "$DISTRIBUTION_URL"
  else
    echo "Error: curl or wget is required to download Gradle." >&2
    exit 1
  fi
  if [ -n "$EXPECTED_SHA" ] && command -v sha256sum >/dev/null 2>&1; then
    ACTUAL_SHA=$(sha256sum "$ZIP_PATH" | awk '{print $1}')
    if [ "$ACTUAL_SHA" != "$EXPECTED_SHA" ]; then
      echo "Error: Gradle ZIP checksum mismatch." >&2
      rm -f "$ZIP_PATH"
      exit 1
    fi
  fi
  if command -v unzip >/dev/null 2>&1; then
    unzip -q -o "$ZIP_PATH" -d "$DIST_ROOT"
  else
    echo "Error: unzip is required to extract Gradle." >&2
    exit 1
  fi
  rm -f "$ZIP_PATH"
fi
exec "$GRADLE_BIN" "$@"
